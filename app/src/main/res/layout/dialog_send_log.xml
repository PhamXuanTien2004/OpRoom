<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textView_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="GỬI LOG TỚI MÁY TÍNH"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Nhập địa chỉ IP máy tính nhận file\n(Ví dụ: 192.168.1.50 hoặc IP Tailscale 100.x.y.z)"
        android:textColor="#666666"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/editText_ipAddress"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:hint="192.168.1.xxx hoặc 100.x.y.z"
        android:inputType="textUri"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="HỦY"
            android:textSize="22sp" />

        <Button
            android:id="@+id/buttonSend"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#2E7D32"
            android:text="GỬI LOG"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>

