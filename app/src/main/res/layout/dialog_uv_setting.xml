<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textViewDummy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  "
        android:textSize="48sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/uvPicker"
        app:layout_constraintEnd_toEndOf="@+id/uvPicker"
        app:layout_constraintStart_toStartOf="@+id/uvPicker"
        app:layout_constraintTop_toTopOf="@+id/uvPicker" />

    <NumberPicker
        android:id="@+id/uvPicker"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:fadeScrollbars="false"
        android:isScrollContainer="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/buttonCancel_UV"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:text="Hủy"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/buttonOK_UV"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonOK_UV" />

    <Button
        android:id="@+id/buttonOK_UV"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:text="OK"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/buttonCancel_UV"
        app:layout_constraintTop_toBottomOf="@+id/uvPicker" />

</androidx.constraintlayout.widget.ConstraintLayout>